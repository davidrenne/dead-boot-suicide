#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 4 ]]; then
  echo "Usage: $0 systemrescue.iso image_folder output.iso"
  exit 1
fi

SYSR="$1"
IMGDIR="$2"
DSK="$3"
OUTISO="$4"

if [[ ! -f "$SYSR" ]]; then echo "ERROR: ISO not found"; exit 1; fi
if [[ ! -d "$IMGDIR" ]]; then echo "ERROR: Image folder not found"; exit 1; fi

command -v xorriso >/dev/null || { echo "Install xorriso"; exit 1; }
command -v 7z >/dev/null || { echo "Install p7zip"; exit 1; }

WORKDIR="$(mktemp -d)"
ISOEX="$WORKDIR/iso"
IMGBASE="$(basename "$IMGDIR")"

mkdir -p "$ISOEX"

echo "[*] Extracting ISO..."
7z x "$SYSR" -o"$ISOEX" > /dev/null

# -----------------------------------
# CREATE AUTORUN RESTORE SCRIPT
# -----------------------------------
mkdir -p "$ISOEX/autorun"

cat > "$ISOEX/autorun/restore" << EOF
#!/usr/bin/env bash

# DEBUG MODE: no set -e, keep shell alive
echo "============================"
echo " DEBUG RESTORE START"
echo "============================"

IMG="/run/archiso/bootmnt/custom-img/$IMGBASE"
DISK="$DSK"

echo " Image dir: \$IMG"
echo " Target disk: \$DISK"
echo

if [[ -z "\$DSK" ]]; then
    echo " ERROR: DSK not detected from CPU model."
    echo " Dropping into shell."
    bash
fi

if [[ ! -d "\$IMG" ]]; then
    echo " ERROR: Image directory missing: \$IMG"
    echo " Dropping into shell."
    bash
fi

cd "\$IMG"

# Partition table restore
if [[ -f d1.partitions ]]; then
    echo " Restoring partition table..."
    sfdisk "\$DISK" < d1.partitions 2>&1 | tee /tmp/restore.log
    partprobe "\$DISK" 2>&1 | tee -a /tmp/restore.log
else
    echo " No d1.partitions found"
fi

echo
echo " Scanning for *-ptcl-img.*"
ls -l | grep ptcl || echo "NONE FOUND"
echo

found_any=0

# Handles files like:
#   nvme0n1p1.vfat-ptcl-img.zst.aa
#   nvme0n1p2.ext4-ptcl-img.zst.ab
for stub in \$(ls *-ptcl-img.* 2>/dev/null | sed -E 's/\\.[A-Za-z0-9]{2}\$//' | sort -u); do
    found_any=1

    part=\$(echo "\$stub" | sed -E 's/.*p([0-9]+).*/\\1/')
    target="\${DISK}p\${part}"
    segs=( "\${stub}".* )

    echo "------------------------------------------------------"
    echo " Restoring stub: \$stub"
    echo " Target partition: \$target"
    echo " Segments: \${segs[*]}"
    echo

    if [[ "\$stub" == *.gz ]]; then
        cat "\${segs[@]}" | gunzip -c | partclone.restore -C -s - -o "\$target"
    elif [[ "\$stub" == *.xz ]]; then
        cat "\${segs[@]}" | xzcat | partclone.restore -C -s - -o "\$target"
    elif [[ "\$stub" == *.zst ]]; then
        cat "\${segs[@]}" | zstd -dc | partclone.restore -C -s - -o "\$target"
    else
        cat "\${segs[@]}" | partclone.restore -C -s - -o "\$target"
    fi
done

echo
echo "============================"
echo " RESTORE COMPLETE"
echo "============================"

if [[ \$found_any -eq 0 ]]; then
    echo " WARNING: No partition images restored!"
fi

shutdown now
EOF

# Make restore executable and also expose it as /autorun/autorun for safety
chmod 755 "$ISOEX/autorun/restore"
cp "$ISOEX/autorun/restore" "$ISOEX/autorun/autorun"
chmod 755 "$ISOEX/autorun/autorun"

# -----------------------------------
# INJECT IMAGE DIRECTORY
# -----------------------------------
mkdir -p "$ISOEX/custom-img"
cp -a "$IMGDIR" "$ISOEX/custom-img/"

VOLID="RESCUE1202"
echo "[*] Using volume label: $VOLID"

# -----------------------------------
# REPACK ISO WITH FULL BOOT SUPPORT
# -----------------------------------
echo "[*] Repacking ISO..."
xorriso -as mkisofs \
    -l -r -J -joliet-long \
    -V "$VOLID" \
    -o "$OUTISO" \
    -isohybrid-mbr "$ISOEX/isolinux/isohdpfx.bin" \
    -c isolinux/boot.cat \
    -b isolinux/isolinux.bin \
        -no-emul-boot -boot-load-size 4 -boot-info-table \
    -eltorito-alt-boot \
    -e EFI/archiso/efiboot.img \
        -no-emul-boot \
    "$ISOEX"

echo "[*] ISO built: $OUTISO"

